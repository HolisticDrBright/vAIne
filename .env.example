# vAIne backend configuration (publishable values only — never secrets).
# Copy to .env for local development; set the same variables as EAS
# environment variables for TestFlight builds. Values live in the Supabase
# dashboard: Project Settings -> API (vaine-beta).
#
# With these unset, the app runs fully local: mock auth, synthetic analysis,
# no network calls.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
